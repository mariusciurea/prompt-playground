APP_NAME=AI Playground
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_playground
# Leave empty in development to use the in-memory store. Required in production.
REDIS_URL=

PUBLIC_BASE_URL=http://localhost:5173
# Behind Caddy in production: X-Client-IP (Caddy sets it from the trusted Cloudflare header).
CLIENT_IP_HEADER=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# false only for local http://localhost development
COOKIE_SECURE=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Anti-bot (optional in dev, required in production). Create a widget at Cloudflare > Turnstile.
TURNSTILE_SECRET_KEY=

# E-mail transport: auto | console | resend | smtp
#   auto    = resend if RESEND_API_KEY set, else smtp if SMTP_HOST set, else console (dev)
#   console = print e-mails to the backend logs (development; no sending)
#   resend  = Resend HTTP API (needs a verified domain)
#   smtp    = any SMTP server, e.g. Gmail with an app password (works without a domain)
EMAIL_BACKEND=auto
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Must match your transport: for Gmail SMTP use your Gmail address.
EMAIL_FROM=AI Playground <noreply@example.com>

GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3-flash-preview
GEMINI_MODEL_NAME=Gemini 3
AGENT_MODEL_ID=gemini-3.5-flash
MAX_PROMPT_LENGTH=10000
MAX_OUTPUT_TOKENS=4096
DEFAULT_TEMPERATURE=1.0

DAILY_PROMPT_LIMIT=70
QUOTA_TIMEZONE=Europe/Bucharest
INSTRUCTORS_EXEMPT_FROM_QUOTA=true

HISTORY_RETENTION_DAYS=30
UNVERIFIED_ACCOUNT_TTL_HOURS=48
